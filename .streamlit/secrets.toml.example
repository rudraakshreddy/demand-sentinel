# Streamlit Community Cloud secrets
# Paste this content into: App Settings → Secrets on share.streamlit.io
# Do NOT commit the actual .streamlit/secrets.toml file (it is gitignored)

[database]
DB_HOST = "db.xxxx.supabase.co"
DB_PORT = "5432"
DB_USER = "postgres"
DB_PASS = "your-supabase-password"
DB_NAME = "postgres"
